{
  "name": "local-ai-short-video-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted local merchant short-video draft generator built with Remotion.",
  "type": "module",
  "scripts": {
    "app": "vite --host 0.0.0.0",
    "build:app": "vite build",
    "dev": "remotion studio src/index.ts",
    "generate": "node scripts/generate-campaign.mjs data/merchant.example.json data/sample.timeline.json",
    "generate:batch": "node scripts/generate-batch.mjs data/merchant.example.json data/campaigns",
    "storyboard": "node scripts/export-storyboard.mjs data/sample.timeline.json out/storyboard.html",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "tauri:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "still": "remotion still src/index.ts VerticalDraft out/preview.png --frame=60 --props=data/sample.timeline.json",
    "render": "remotion render src/index.ts VerticalDraft out/vertical-draft.mp4 --props=data/sample.timeline.json",
    "sync:timeline": "node scripts/sync-workbench-export.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts eslint.config.js",
    "format": "prettier --write src tests scripts data",
    "format:check": "prettier --check src tests scripts data",
    "test": "vitest run && node scripts/workbench-smoke-test.mjs",
    "test:unit": "vitest run tests/unit.test.ts tests/contract.test.ts",
    "test:component": "vitest run tests/component.test.tsx",
    "test:render": "vitest run tests/render.test.ts",
    "test:smoke": "node scripts/workbench-smoke-test.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.499",
    "@remotion/media": "4.0.499",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.499",
    "vite": "^7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
